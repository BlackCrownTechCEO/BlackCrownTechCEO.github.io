---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import Badge from "@/components/Badge.astro";
import { getListPage } from "@/lib/contentParser";

const page_header = {
  badge: "Projects",
  title: "What We're Building.\n<br/>\n<mark>Every Line in Production.</mark>",
  subtitle: "Eleven initiatives shipping under the BlackCrownTech crown — from autonomous coding agents to encrypted relays, from a top-down action-RPG with a graph-memory world to MCP servers that other agents adopt directly.",
};

const callToAction = await getListPage("sections/call-to-action.md");

const projects = [
  {
    icon: "⚔️",
    name: "Anti-Sloper",
    tagline: "Quality skill for AI coding agents — every warning matters, every bug ships with a regression test.",
    body: "A ruthless, checklist-driven quality and remediation skill that turns any AI coding agent (Claude Code, Codex, Cursor, Gemini CLI, GitHub Copilot, Amp, Continue) into a quality-first engineer. Runs static analysis → tests → build, kills dead code, replaces 'what' comments with 'why', reproduces every bug + adds a regression test that would have caught it.",
    tags: ["Universal Skill", "Quality", "TDD", "Multi-Agent"],
    status: "live",
    url: "https://github.com/BlackCrownTech-Inc/Anti-Sloper",
    install: "npx skills add https://github.com/BlackCrownTech-Inc/Anti-Sloper",
  },
  {
    icon: "🤖",
    name: "BlackCrownAgent",
    tagline: "Elite offline AI coding agent — local LLM, multi-agent DAG orchestration, browser dashboard.",
    body: "Next.js 16 dashboard + FastAPI backend hosting a DAG of specialized agents (coding, debugging, research) coordinated by BlackCrownAgentLoop with token-compaction. Runs entirely on local Ollama / llama.cpp models with SQLite + Chroma memory. 29 passing tests; works without an internet connection.",
    tags: ["Next.js 16", "FastAPI", "Ollama", "Chroma", "DAG"],
    status: "beta",
    url: "https://github.com/BlackCrownTechCEO",
  },
  {
    icon: "🛡️",
    name: "VOID OMEGA Network",
    tagline: "Backend-first autonomous secure-relay system with mobile, desktop, web, and operator-terminal surfaces.",
    body: "Multi-surface secure operator platform. VOID Ω SENTINEL backend + mobile app + web app + desktop app + encrypted relay / command path with onion-capable transport. Governance, audit, persistence, and autonomy layers as primary citizens — not afterthoughts.",
    tags: ["Python", "TypeScript", "Tor", "Audit", "Multi-Surface"],
    status: "beta",
    url: "https://github.com/BlackCrownTech-Inc/VOID-OMEGA-network",
  },
  {
    icon: "🧠",
    name: "VOID OMEGA Security Brain v6",
    tagline: "Full-stack autonomous security-intelligence platform with a 4D rotating threat-correlation sphere.",
    body: "Integrates the VOID Ω SENTINEL relay with a multi-provider AI brain, a real-time Canvas attack-map, and a 4D rotating brain-sphere visualizing live threat correlation. Single-file HTML dashboard (167 KB) sits on top of the openclaude CLI engine (414 commits, TypeScript 99.4%).",
    tags: ["Security", "Canvas", "Multi-Provider AI", "Visualization"],
    status: "beta",
    url: "https://github.com/BlackCrownTechCEO",
  },
  {
    icon: "💬",
    name: "VOID.Chat",
    tagline: "Real-time messaging platform — encrypted channels, multi-device sync, no bloat.",
    body: "Lean chat application built around realtime channels, encrypted DMs, and multi-device sync. No ad-tracking, no surveillance hooks. Open source so anyone can audit the network layer.",
    tags: ["JavaScript", "WebSocket", "Realtime", "E2EE"],
    status: "live",
    url: "https://github.com/BlackCrownTechCEO/VOID.Chat",
  },
  {
    icon: "🧿",
    name: "Black Aether",
    tagline: "Encrypted social platform — identities without phone numbers, content without ad tracking.",
    body: "Next.js 16 social platform exploring what social networking looks like when identity isn't tied to a phone number and content isn't ranked by advertising incentive. Geist font, server components, Vercel-grade deployment topology.",
    tags: ["Next.js 16", "TypeScript", "Social", "E2EE"],
    status: "alpha",
    url: "https://github.com/BlackCrownTech-Inc",
  },
  {
    icon: "🔥",
    name: "CrownForge Harness",
    tagline: "Issue-driven coding-agent harness with Codex + Claude adapters, Symphony contract, audit log.",
    body: "Harness-engineering system built from a strict SPEC.md Symphony contract. WORKFLOW.md loader with YAML front matter, Linear-shaped issue tracker, per-issue workspace manager, hook runner (after_create / before_run / after_run / before_remove), agent adapters for codex app-server and claude CLI, scheduler with retry state, JSONL audit log, local operator UI.",
    tags: ["Agents", "Codex", "Claude", "Symphony", "Audit"],
    status: "beta",
    url: "https://github.com/BlackCrownTechCEO",
  },
  {
    icon: "🪞",
    name: "claude-code-mcp",
    tagline: "MCP server exposing Claude Code capabilities to other AI agents.",
    body: "Model Context Protocol server that lets any MCP-aware client (Cursor, OpenClaw, Continue, Codex, Gemini CLI, custom agents) call into Claude Code's editing and reasoning capabilities programmatically. Foundation for cross-agent workflows.",
    tags: ["MCP", "TypeScript", "Interop"],
    status: "live",
    url: "https://github.com/BlackCrownTechCEO",
  },
  {
    icon: "👁️",
    name: "JARVIS V.I",
    tagline: "Real-time agentic intelligence platform streamed to Meta Ray-Ban smart glasses.",
    body: "Autonomous web-scraping + OSINT agent with a real-time intelligence-gathering pipeline streamed live to smart-glasses HUD. Python core, multi-agent search graph, configurable OSINT modules.",
    tags: ["Python", "OSINT", "XR", "Smart Glasses"],
    status: "rd",
    url: "https://github.com/BlackCrownTechCEO/JARVIS.V.I",
  },
  {
    icon: "🗡️",
    name: "Void Bound — The Fracture Chronicles",
    tagline: "Grimdark top-down action-RPG where the world remembers everything you do.",
    body: "Godot 4 / GDScript action-RPG with a Libram of Deeds — a persistent graph that records every meaningful action and drives NPC memory, faction reactions, and emergent story. SQLite-backed graph, three-quarter perspective, pixel-art + painted atmospheric depth, 1–4 player co-op on the roadmap. No quest markers. No forced missions.",
    tags: ["Godot 4", "GDScript", "SQLite", "Action-RPG"],
    status: "alpha",
    url: "https://github.com/BlackCrownTechCEO",
  },
  {
    icon: "🦾",
    name: "OpenClaude — VOID OMEGA NETWORK Edition",
    tagline: "Open-source coding-agent CLI supporting 200+ models via OpenAI-compatible APIs.",
    body: "TypeScript CLI engine bringing Claude-Code-style ergonomics to OpenAI, Gemini, DeepSeek, Ollama, Codex, GitHub Models, and any OpenAI-compatible provider. The execution layer behind the VOID OMEGA Security Brain — 414 commits, 99.4% TypeScript.",
    tags: ["TypeScript", "CLI", "Multi-Provider", "Agents"],
    status: "live",
    url: "https://github.com/BlackCrownTechCEO/openclaude-VOID-OMEGA-NETWORK-",
  },
];

const statusMap: Record<string, { label: string; className: string }> = {
  live: { label: "Live", className: "border-green-400/40 text-green-400 bg-green-400/10" },
  beta: { label: "Beta", className: "border-primary/40 text-primary bg-primary/10" },
  alpha: { label: "Alpha", className: "border-purple-400/40 text-purple-400 bg-purple-400/10" },
  rd: { label: "R&D", className: "border-border/30 text-gray bg-dark_gray/40" },
};
---

<Base
  title="Projects — BlackCrownTech"
  meta_title="Projects — BlackCrownTech"
  description="Eleven projects from BlackCrownTech: autonomous coding agents, secure relay networks, MCP servers, encrypted messaging, and developer tooling."
>
  <PageHeader page_header={page_header} />

  <section>
    <div class="main-container">
      <div class="container">
        <div class="container-padding-x container-padding-y">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {projects.map((p) => {
              const status = statusMap[p.status] ?? statusMap.rd;
              return (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group relative flex flex-col gap-4 border border-border/7 bg-gradient-dark rounded-3xl p-7 overflow-hidden transition hover:border-primary/40"
                >
                  <div class="absolute -top-20 -right-20 w-60 h-60 rounded-full bg-primary/10 blur-3xl opacity-0 group-hover:opacity-100 transition" />

                  <div class="flex items-start justify-between gap-3 relative z-1">
                    <div class="w-14 h-14 rounded-2xl border border-primary/30 bg-primary/10 flex items-center justify-center text-2xl">
                      {p.icon}
                    </div>
                    <span class={`text-[0.65rem] tracking-widest uppercase border rounded-full px-2.5 py-1 font-mono ${status.className}`}>
                      {status.label}
                    </span>
                  </div>

                  <div class="relative z-1">
                    <h3 class="text-h5 font-semibold mb-2">{p.name}</h3>
                    <p class="text-sm text-text_light/90 mb-3 leading-relaxed">{p.tagline}</p>
                    <p class="text-sm text-gray leading-relaxed">{p.body}</p>
                  </div>

                  <div class="flex flex-wrap gap-1.5 mt-auto relative z-1">
                    {p.tags.map((t) => (
                      <span class="text-[0.7rem] font-mono text-gray border border-border/30 bg-dark/40 rounded-md px-2 py-0.5">
                        {t}
                      </span>
                    ))}
                  </div>

                  {p.install && (
                    <div class="relative z-1 mt-1 font-mono text-[0.7rem] text-primary/80 bg-dark/60 border border-border/30 rounded-lg px-3 py-2 break-all">
                      $ {p.install}
                    </div>
                  )}

                  <div class="relative z-1 flex items-center gap-1.5 text-sm font-semibold text-primary mt-1">
                    View on GitHub
                    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" class="transition group-hover:translate-x-1">
                      <path fill="currentColor" d="M5 12h12.2l-4.6-4.6L14 6l7 7-7 7-1.4-1.4 4.6-4.6H5z"/>
                    </svg>
                  </div>
                </a>
              );
            })}
          </div>

          <div class="mt-12 text-center">
            <Badge>And more in the pipeline</Badge>
            <p class="mt-4 text-gray max-w-2xl mx-auto">
              SkyNet (autonomous research), VOID OMEGA PROJECT (full-stack security brain build pipeline), claude-code-mcp,
              and a portfolio of MCP servers and agent skills shipping under the BlackCrownTech crown — view the full
              source list on <a href="https://github.com/BlackCrownTechCEO?tab=repositories" target="_blank" rel="noopener" class="text-primary underline">github.com/BlackCrownTechCEO</a>
              and <a href="https://github.com/BlackCrownTech-Inc" target="_blank" rel="noopener" class="text-primary underline">github.com/BlackCrownTech-Inc</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>
